{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tokinagi-publication",
	"compatibility_date": "2026-08-23",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"pattern": "tokinonagi.dpdns.org",
			"custom_domain": true
		}
	]
}
