---
import { Icon } from "astro-icon/components";

// 右下角快捷菜单：音乐入口 + 展开式导航
const items = [
	{
		label: "公告",
		href: "/messages/",
		icon: "material-symbols:campaign-outline-rounded",
	},
	{
		label: "标签",
		href: "/tags/",
		icon: "material-symbols:label-outline-rounded",
	},
	{
		label: "主页",
		href: "/",
		icon: "material-symbols:home-outline-rounded",
	},
];
---

<quick-fab-menu class="quick-fab" data-expanded="false">
	<div class="quick-fab__stack" id="quick-fab-stack">
		{
			items.map((item) => (
				<a
					class="quick-fab__btn"
					href={item.href}
					data-tip={item.label}
					aria-label={item.label}
				>
					<Icon name={item.icon} class="quick-fab__icon" />
				</a>
			))
		}
		<button
			type="button"
			class="quick-fab__btn quick-fab__theme"
			data-theme-control
			data-tip="主题：跟随系统"
			aria-label="主题：跟随系统；点击切换为白日模式"
		>
			<span class="quick-fab__theme-icon" data-theme-icon="light">
				<Icon
					name="material-symbols:wb-sunny-outline-rounded"
					class="quick-fab__icon"
				/>
			</span>
			<span class="quick-fab__theme-icon" data-theme-icon="dark">
				<Icon
					name="material-symbols:dark-mode-outline-rounded"
					class="quick-fab__icon"
				/>
			</span>
			<span class="quick-fab__theme-icon" data-theme-icon="system">
				<Icon
					name="material-symbols:desktop-windows"
					class="quick-fab__icon"
				/>
			</span>
		</button>
	</div>
	<a
		class="quick-fab__btn quick-fab__music"
		href="/music/"
		data-tip="音乐"
		aria-label="音乐"
	>
		<Icon
			name="material-symbols:music-note-rounded"
			class="quick-fab__icon"
		/>
	</a>
	<button
		type="button"
		class="quick-fab__btn quick-fab__toggle"
		aria-expanded="false"
		aria-controls="quick-fab-stack"
		aria-label="展开快捷菜单"
	>
		<Icon
			name="material-symbols:more-horiz-rounded"
			class="quick-fab__icon quick-fab__icon-more"
		/>
		<Icon
			name="material-symbols:close-rounded"
			class="quick-fab__icon quick-fab__icon-close"
		/>
	</button>
</quick-fab-menu>

<style>
	.quick-fab {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 60;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.625rem;
	}

	.quick-fab__stack {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.625rem;
	}

	.quick-fab__btn {
		position: relative;
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		border: 1px solid var(--publication-line);
		border-radius: 0.9rem;
		/* 液态玻璃：半透明白 + 背景模糊 + 顶部高光 */
		background: linear-gradient(
			160deg,
			rgba(255, 255, 255, 0.82),
			rgba(255, 255, 255, 0.55)
		);
		backdrop-filter: blur(1rem) saturate(1.6);
		-webkit-backdrop-filter: blur(1rem) saturate(1.6);
		color: var(--primary);
		text-decoration: none;
		box-shadow:
			0 0.5rem 1.5rem rgba(39, 91, 112, 0.14),
			inset 0 1px 0 rgba(255, 255, 255, 0.95),
			inset 0 -1px 0 rgba(8, 126, 164, 0.08);
		transition:
			transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.24s ease,
			box-shadow 0.24s ease,
			visibility 0.32s;
	}

	.quick-fab__btn:hover {
		color: var(--publication-accent);
		background: linear-gradient(
			160deg,
			rgba(255, 255, 255, 0.95),
			rgba(255, 255, 255, 0.7)
		);
		box-shadow:
			0 0.75rem 1.75rem rgba(39, 91, 112, 0.2),
			inset 0 1px 0 #fff,
			inset 0 -1px 0 rgba(8, 126, 164, 0.12);
		transform: translateY(-2px);
	}

	:global(:root.dark) .quick-fab__btn {
		background: linear-gradient(
			160deg,
			rgba(34, 48, 55, 0.9),
			rgba(20, 31, 36, 0.72)
		);
		box-shadow:
			0 0.5rem 1.5rem rgba(0, 0, 0, 0.3),
			inset 0 1px 0 rgba(255, 255, 255, 0.12),
			inset 0 -1px 0 rgba(103, 212, 241, 0.08);
	}

	:global(:root.dark) .quick-fab__btn:hover {
		background: linear-gradient(
			160deg,
			rgba(42, 61, 69, 0.96),
			rgba(26, 40, 46, 0.86)
		);
		box-shadow:
			0 0.75rem 1.75rem rgba(0, 0, 0, 0.38),
			inset 0 1px 0 rgba(255, 255, 255, 0.16),
			inset 0 -1px 0 rgba(103, 212, 241, 0.12);
	}

	.quick-fab__icon {
		font-size: 1.25rem;
	}

	.quick-fab__theme-icon {
		display: none;
	}

	.quick-fab[data-theme-preference="light"] [data-theme-icon="light"],
	.quick-fab[data-theme-preference="dark"] [data-theme-icon="dark"],
	.quick-fab[data-theme-preference="system"] [data-theme-icon="system"] {
		display: grid;
	}

	/* 黑色气泡提示（截图样式） */
	.quick-fab__btn::after {
		content: attr(data-tip);
		position: absolute;
		right: calc(100% + 0.75rem);
		top: 50%;
		padding: 0.375rem 0.75rem;
		transform: translateY(-50%) scale(0.9);
		transform-origin: right center;
		border-radius: 0.625rem;
		background: #111;
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.quick-fab__btn:hover::after,
	.quick-fab__btn:focus-visible::after {
		opacity: 1;
		transform: translateY(-50%) scale(1);
	}

	/* 折叠状态：堆栈内的按钮滑出收起（stagger，类 codexapp 滑动动效） */
	.quick-fab[data-expanded="false"] .quick-fab__stack .quick-fab__btn {
		visibility: hidden;
		opacity: 0;
		transform: translateY(1rem) scale(0.8);
		pointer-events: none;
		position: absolute;
	}

	/* 展开时自下而上依次滑入 */
	.quick-fab[data-expanded="true"] .quick-fab__stack .quick-fab__btn:nth-child(1) {
		transition-delay: 0.08s;
	}

	.quick-fab[data-expanded="true"] .quick-fab__stack .quick-fab__btn:nth-child(2) {
		transition-delay: 0.14s;
	}

	.quick-fab[data-expanded="true"] .quick-fab__stack .quick-fab__btn:nth-child(3) {
		transition-delay: 0.2s;
	}

	.quick-fab[data-expanded="true"] .quick-fab__stack .quick-fab__btn:nth-child(4) {
		transition-delay: 0.26s;
	}

	/* 收起时自上而下依次滑出 */
	.quick-fab[data-expanded="false"] .quick-fab__stack .quick-fab__btn:nth-child(2) {
		transition-delay: 0.05s;
	}

	.quick-fab[data-expanded="false"] .quick-fab__stack .quick-fab__btn:nth-child(3) {
		transition-delay: 0.1s;
	}

	.quick-fab__toggle {
		cursor: pointer;
		font-family: inherit;
	}

	.quick-fab__icon-close {
		display: none;
	}

	.quick-fab[data-expanded="true"] .quick-fab__icon-more {
		display: none;
	}

	.quick-fab[data-expanded="true"] .quick-fab__icon-close {
		display: block;
	}

	@media (max-width: 480px) {
		.quick-fab {
			right: 0.625rem;
			bottom: 0.625rem;
			gap: 0.5rem;
		}

		.quick-fab__btn {
			width: 2.5rem;
			height: 2.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.quick-fab__btn,
		.quick-fab__btn::after {
			transition: none;
		}
	}

	/* 展开时隐藏回顶/回主页按钮，避免与菜单重叠 */
	:global(body.quick-fab-open .floating-controls-container) {
		opacity: 0;
		pointer-events: none;
	}

	:global(.floating-controls-container) {
		transition: opacity 0.18s ease;
	}
</style>

<script>
	import { getStoredTheme, setTheme } from "@utils/setting-utils";
	import { nextThemePreference } from "@utils/theme-preference";

	class QuickFabMenu extends HTMLElement {
		private toggle: HTMLButtonElement | null = null;
		private themeControl: HTMLButtonElement | null = null;
		private readonly handleThemePreferenceChange = () =>
			this.syncThemeControl();

		connectedCallback() {
			this.toggle = this.querySelector(".quick-fab__toggle");
			this.themeControl = this.querySelector("[data-theme-control]");
			this.toggle?.addEventListener("click", () => this.setExpanded());
			this.themeControl?.addEventListener("click", () => {
				setTheme(nextThemePreference(getStoredTheme()));
			});
			window.addEventListener(
				"theme-preference-change",
				this.handleThemePreferenceChange,
			);
			this.syncThemeControl();
			document.addEventListener("keydown", (event) => {
				if (
					event.key === "Escape" &&
					this.dataset.expanded === "true"
				) {
					this.setExpanded(false);
					this.toggle?.focus();
				}
			});
			document.addEventListener("click", (event) => {
				if (
					this.dataset.expanded === "true" &&
					event.target instanceof Node &&
					!this.contains(event.target)
				) {
					this.setExpanded(false);
				}
			});
		}

		disconnectedCallback() {
			window.removeEventListener(
				"theme-preference-change",
				this.handleThemePreferenceChange,
			);
		}

		private syncThemeControl() {
			const preference = getStoredTheme();
			const labels = {
				light: "白日模式",
				dark: "黑夜模式",
				system: "跟随系统",
			};
			const nextLabels = {
				light: "黑夜模式",
				dark: "跟随系统",
				system: "白日模式",
			};
			this.dataset.themePreference = preference;
			this.themeControl?.setAttribute(
				"data-tip",
				`主题：${labels[preference]}`,
			);
			this.themeControl?.setAttribute(
				"aria-label",
				`主题：${labels[preference]}；点击切换为${nextLabels[preference]}`,
			);
		}

		private setExpanded(force?: boolean) {
			const next = force ?? this.dataset.expanded !== "true";
			this.dataset.expanded = String(next);
			document.body.classList.toggle("quick-fab-open", next);
			this.toggle?.setAttribute("aria-expanded", String(next));
			this.toggle?.setAttribute(
				"aria-label",
				next ? "收起快捷菜单" : "展开快捷菜单",
			);
		}
	}

	if (!customElements.get("quick-fab-menu")) {
		customElements.define("quick-fab-menu", QuickFabMenu);
	}
</script>
